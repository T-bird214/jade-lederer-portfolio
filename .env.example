# Copia este archivo a .env para desarrollo local (npm run dev).
# En producción, configura las variables en Vercel → portafolio-comercial-jade → Settings → Environment Variables.

# --- Asistente IA (/api/chat) ---
# Clave de Gemini (Google AI Studio). Sin ella, el chat responde con un mensaje de respaldo.
GEMINI_API_KEY=""
# Opcional: modelo de Gemini (por defecto gemini-3.5-flash).
GEMINI_MODEL=""

# --- Formulario de contacto ---
# Access key de Web3Forms (pública por diseño; se incrusta en el sitio al compilar).
# Si está definida, el formulario envía directo desde el navegador a Web3Forms.
VITE_WEB3FORMS_ACCESS_KEY=""

# Alternativa por servidor (/api/contact) para cuando haya dominio propio: Resend.
# Solo se usa si VITE_WEB3FORMS_ACCESS_KEY está vacía.
RESEND_API_KEY=""
CONTACT_TO_EMAIL=""
# Opcional: remitente verificado en Resend (por defecto onboarding@resend.dev).
CONTACT_FROM_EMAIL=""
